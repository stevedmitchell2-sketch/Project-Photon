{
  "name": "project-photon",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "PROJECT PHOTON - a first-person laser tag arena shooter with authoritative-server multiplayer",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "server": "tsx server/index.ts",
    "nettest": "tsx scripts/netTest.ts",
    "server:dev": "tsx server/index.ts --port 8090 --bots 0",
    "predict-ab": "tsx scripts/predictionAB.ts",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"server/**/*.ts\" \"scripts/**/*.ts\" \"tests/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\" \"server/**/*.ts\" \"tests/**/*.ts\"",
    "test:coverage": "vitest run --coverage",
    "validate": "npm run typecheck && npm run lint && npm run test && npm run build",
    "latency-sweep": "tsx scripts/latencySweep.ts",
    "predict-align": "tsx scripts/predictionAlign.ts",
    "scale": "tsx scripts/processScale.ts"
  },
  "dependencies": {
    "@dimforge/rapier3d-compat": "^0.14.0",
    "@react-three/drei": "^9.114.0",
    "@react-three/fiber": "^8.17.10",
    "@react-three/postprocessing": "^2.16.3",
    "postprocessing": "^6.36.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "^0.169.0",
    "ws": "^8.18.0",
    "zustand": "^5.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/three": "^0.169.0",
    "@types/ws": "^8.5.13",
    "@vitejs/plugin-react": "^4.3.3",
    "eslint": "^9.39.5",
    "globals": "^17.8.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.65.0",
    "vite": "^5.4.10",
    "vitest": "^2.1.4"
  },
  "license": "UNLICENSED",
  "engines": {
    "node": ">=20"
  }
}
